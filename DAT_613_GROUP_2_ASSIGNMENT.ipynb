      ],
      "source": [
        "use_kg = daily @ recipe / 1000\n",
        "assert use_kg.shape == (n_branches, n_days, len(ingredients))\n",
        "\n",
        "print(daily.shape, '@', recipe.shape, '-', use_kg.shape)"
