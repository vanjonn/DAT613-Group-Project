          "text": [
            "Rice - 0.28 g per portion\n",
            "Chicken - 300.0 g per portion\n",
            "Beef/Goat - 350.0 g per portion\n",
            "Vegetable oil - 60.0 g per portion\n",
            "Pepper & tomato mix - 150.0 g per portion\n",
            "Yam/Pounded yam flour - 300.0 g per portion\n",
            "Beans - 150.0 g per portion\n",
            "Plantain - 250.0 g per portion\n"
          ]
        }
      ],
      "source": [
        "for k in range(len(ingredients)):\n",
        "    print(ingredients[k], '-', recipe[:, k].max(), 'g per portion')"
      ],
      "id": "n1XX9lpqBkCn"
