        "id": "YtWem2pzBkCp",
        "outputId": "fe7a4001-9085-4a60-ab73-2014a5f79aa8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Fixed swap at Abuja-Wuse : Suya Platter and Goat Meat Pepper Soup\n",
            "Rescaled Rice from kg to g\n",
            "Excluded 31 closed branch-days\n",
            "Shapes: (483840,) then (12, 84, 48, 10) then (12, 84, 8)\n"
          ]
        }
      ],
      "source": [
        "def run_pipeline(path):\n",
        "\n",
        # Load the dataset using the path provided to the function
        "    data = np.load(\"/content/group02_restaurant_7670.npz\")\n",
        "\n",
        "    branches = data['branches']\n",
        "    items = data['items']\n",
        "    ingredients = data['ingredients']\n",
        "    prices = data['prices_naira'].astype(float)\n",
        "    recipe = data['recipe_grams_per_portion'].astype(float)\n",
        "    till = data['daily_till_revenue'].astype(float)\n",
        "\n",
        "    n_branches = len(branches)\n",
        "    n_items = len(items)\n",
        "\n",
        "    # step 1\n",
        "    grid = to_grid(data['sales'].astype(float), n_branches, n_items)\n",
        "    n_days = grid.shape[1]\n",
        "\n",
        "    # step 2\n",
        "    daily = grid.sum(axis=2)\n",
        "    swap = find_swap(daily, prices, till)\n",
        "    if swap is not None:\n",
        "        b, a1, a2 = swap\n",
        "        grid[b][:, :, [a1, a2]] = grid[b][:, :, [a2, a1]]\n",
        "        daily = grid.sum(axis=2)\n",
        "        print('Fixed swap at', branches[b], ':', items[a1], 'and', items[a2])\n",
        "\n",
        "    # step 3\n",
        "    recipe = fix_units(recipe, ingredients)\n",
        "\n",
        "    # step 4\n",
        "    closed = daily.sum(axis=2) == 0\n",
        "    daily[closed] = np.nan\n",
        "    print('Excluded', closed.sum(), 'closed branch-days')\n",
        "\n",
        "    # step 5 and the answers\n",
        "    use_kg = daily @ recipe / 1000\n",
        "    weeks = n_days // 7\n",
        "    by_week = use_kg[:, :weeks * 7, :].reshape(n_branches, weeks, 7, len(ingredients))\n",
        "    order = np.nanpercentile(by_week, 90, axis=1)\n",
        "\n",
        "    per_slot = grid.sum(axis=3)\n",
        "    per_slot[closed] = np.nan\n",
        "    avg_slot = np.nanmean(per_slot, axis=1)\n",
        "    busiest = np.argmax(avg_slot, axis=1)\n",
        "\n",
        "    print('Shapes:', data['sales'].shape, 'then', grid.shape, 'then', use_kg.shape)\n",
        "\n",
        "    return {'order': order, 'avg_slot': avg_slot, 'busiest': busiest,\n",
        "            'branches': branches, 'ingredients': ingredients}\n",
        "\n",
        "results = run_pipeline(\"/content/group02_restaurant_7670.npz\")"
      ],
      "id": "YtWem2pzBkCp"
    },
