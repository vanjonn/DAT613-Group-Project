      "source": [
        "Bonus - loops vs NumPy\n",
        " The same ingredient calculation written both ways."
      ],
      "id": "HS_ifVe4BkCp"
    },
    {
      "cell_type": "code",
      "execution_count": 121,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "aRwddZm4BkCp",
        "outputId": "ccfd7e97-fbf0-4c32-9318-bb47ef693baf"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "loops: 81.9 ms\n",
            "numpy: 0.245 ms\n",
            "numpy is 334 times faster\n",
            "same answer: True\n"
          ]
        }
      ],
      "source": [
        "import time\n",
        "\n",
        "def use_with_loops(daily, recipe):\n",
        "    out = np.zeros((daily.shape[0], daily.shape[1], recipe.shape[1]))\n",
        "    for b in range(daily.shape[0]):\n",
        "        for d in range(daily.shape[1]):\n",
        "            for i in range(daily.shape[2]):\n",
        "                for g in range(recipe.shape[1]):\n",
        "                    out[b, d, g] += daily[b, d, i] * recipe[i, g]\n",
        "    return out / 1000\n",
        "\n",
        "clean = np.nan_to_num(daily)\n",
        "\n",
        "start = time.time()\n",
        "slow = use_with_loops(clean, recipe)\n",
        "loop_time = time.time() - start\n",
        "\n",
        "start = time.time()\n",
        "fast = clean @ recipe / 1000\n",
        "numpy_time = time.time() - start\n",
        "\n",
        "print('loops:', round(loop_time * 1000, 1), 'ms')\n",
        "print('numpy:', round(numpy_time * 1000, 3), 'ms')\n",
        "print('numpy is', round(loop_time / numpy_time), 'times faster')\n",
        "print('same answer:', np.allclose(slow, fast))"
      ],
      "id": "aRwddZm4BkCp"
    }
