      "source": [
        "rice = list(ingredients).index('Rice')\n",
        "\n",
        "for i in range(n_branches):\n",
        "    kept = np.nan_to_num(daily[i]) @ recipe[:, rice] / 1000\n",
        "    skipped = daily[i] @ recipe[:, rice] / 1000\n",
        "    a = kept.mean()\n",
